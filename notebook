        "#Utilizo una funcion para transformar la columna, limpiar espacios y calcular el promedio\n",
        "def owners_to_average(value):\n",
        "    if pd.isna(value):\n",
        "        return None\n",
        "    # Separar por '..'\n",
        "    parts = value.split('..')\n",
        "\n",
        "    # Quitar comas y espacios\n",
        "    nums = [int(p.replace(',', '').strip()) for p in parts]\n",
        "\n",
        "    # Calcular promedio\n",
        "    return sum(nums) / len(nums)\n",
        "\n",
