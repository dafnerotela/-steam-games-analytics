        "upper = Q3 + 1.5*IQR\n",
        "lower = Q1 - 1.5*IQR\n",
        "\n",
        "outliers = df[(df['avg_forever_h'] > upper) | (df['avg_forever_h'] < lower)]\n",
        "print(len(outliers), \"outliers detectados\")\n",
        "\n"
